{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "catatan-bisnis",
  "version": "0.1.0",
  "identifier": "com.kalo.catatan-bisnis",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": null,
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "catatan-bisnis",
        "width": 384,
        "height": 853.1,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "schemes": ["catatbisnis"]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["catatbisnis"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["catatbisnis"]
      }
    }
  }
}
